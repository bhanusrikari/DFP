# --- Database ---
DATABASE_URL="file:./dev.db"

# --- Auth ---
JWT_SECRET="dev-only-change-me"

# --- AI provider: "mock" (default, no key needed) or "claude" ---
AI_PROVIDER=mock
ANTHROPIC_API_KEY=

# --- Reminder provider: "console" (default, logs only) or "twilio" ---
REMINDER_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# --- Server ---
PORT=4000
WEB_ORIGIN=http://localhost:5173

# --- Demo speed: compress reminder scheduling so waits are seconds, not days ---
DEMO_TIME_ACCELERATION=1440
